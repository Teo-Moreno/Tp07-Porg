@model Usuario
@{
    ViewData["Title"] = "Registrarse";
}

<div class="auth-card card shadow-sm mx-auto">
    <div class="card-body p-4">
        <h1 class="h4 mb-4 text-center">Crear cuenta</h1>

        @if (ViewBag.Error != null)
        {
            <div class="alert alert-danger py-2">@ViewBag.Error</div>
        }

        <form asp-controller="Account" asp-action="Registro" method="post">
            <div class="row g-3 mb-3">
                <div class="col-sm-6">
                    <label for="Nombre" class="form-label">Nombre</label>
                    <input type="text" id="Nombre" name="Nombre" class="form-control" value="@Model.Nombre" maxlength="50" required />
                </div>
                <div class="col-sm-6">
                    <label for="Apellido" class="form-label">Apellido</label>
                    <input type="text" id="Apellido" name="Apellido" class="form-control" value="@Model.Apellido" maxlength="50" required />
                </div>
            </div>
            <div class="mb-3">
                <label for="NombreUsuario" class="form-label">Nombre de usuario</label>
                <input type="text" id="NombreUsuario" name="NombreUsuario" class="form-control" value="@Model.NombreUsuario" maxlength="50" required />
            </div>
            <div class="mb-3">
                <label for="contrasena" class="form-label">Contraseña</label>
                <input type="password" id="contrasena" name="contrasena" class="form-control" minlength="6" maxlength="50" required />
            </div>
            <div class="mb-4">
                <label for="confirmacion" class="form-label">Repetir contraseña</label>
                <input type="password" id="confirmacion" name="confirmacion" class="form-control" minlength="6" maxlength="50" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Registrarme</button>
        </form>

        <p class="text-center mt-3 mb-0">
            ¿Ya tenés cuenta? <a asp-controller="Account" asp-action="Login">Iniciá sesión</a>
        </p>
    </div>
</div>
